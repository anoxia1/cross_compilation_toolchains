prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include/qt5


Name: Qt5 WaylandClient
Description: Qt WaylandClient module
Version: 5.15.11
Libs: -L${libdir} -lQt5WaylandClient 
Cflags: -DQT_WAYLANDCLIENT_LIB -I${includedir}/QtWaylandClient -I${includedir}
Requires: Qt5Core Qt5Gui
