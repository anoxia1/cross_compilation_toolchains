prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include/qt5


Name: Qt5 WaylandCompositor
Description: Qt WaylandCompositor module
Version: 5.15.11
Libs: -L${libdir} -lQt5WaylandCompositor 
Cflags: -DQT_WAYLANDCOMPOSITOR_LIB -I${includedir}/QtWaylandCompositor -I${includedir}
Requires: Qt5Core Qt5Gui Qt5Quick Qt5Qml
