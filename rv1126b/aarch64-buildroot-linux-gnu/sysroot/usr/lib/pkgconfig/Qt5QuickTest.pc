prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include/qt5


Name: Qt5 QuickTest
Description: Qt QuickTest module
Version: 5.15.11
Libs: -L${libdir} -lQt5QuickTest 
Cflags: -DQT_QMLTEST_LIB -I${includedir}/QtQuickTest -I${includedir}
Requires: Qt5Core Qt5Test Qt5Widgets
