prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include/qt5


Name: Qt5 VirtualKeyboard
Description: Qt VirtualKeyboard module
Version: 5.15.11
Libs: -L${libdir} -lQt5VirtualKeyboard 
Cflags: -DQT_VIRTUALKEYBOARD_LIB -I${includedir}/QtVirtualKeyboard -I${includedir}
Requires: Qt5Core Qt5Gui Qt5Qml Qt5Quick
