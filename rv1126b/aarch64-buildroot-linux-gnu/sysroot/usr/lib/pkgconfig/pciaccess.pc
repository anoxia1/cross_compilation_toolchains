prefix=/usr
exec_prefix=/usr
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: pciaccess
Description: Library providing generic access to the PCI bus and devices.
Version: 0.17
Cflags: -I${includedir}
Libs: -L${libdir} -lpciaccess
Libs.Private:  -L${pcfiledir}/../../../../../host/bin/../aarch64-buildroot-linux-gnu/sysroot/usr/lib -lz
